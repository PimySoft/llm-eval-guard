# Required: local Ollama judge model (the $0-cost default — see VISION.md)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: override the judge model pulled via `ollama pull`. Defaults to qwen2.5:0.5b, chosen
# for CPU-only CI runner speed — re-run `python scripts/calibrate_judge.py` before trusting a
# different model's scores (see docs/judge-calibration.md).
# LEG_JUDGE_MODEL=qwen2.5:0.5b

# Optional bring-your-own-key adapters — never required to run the test suite.
# Uncomment and set only if you want a paid provider instead of the local judge.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
